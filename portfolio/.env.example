# Copy to .env.local. Public values only: they are compiled into the site.
# Local: printed by `npm run db:start`. Production: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (no NEXT_PUBLIC_ prefix). Same value as the github-sync function's REVALIDATE_SECRET.
REVALIDATE_SECRET=
