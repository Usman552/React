# Copy to supabase/functions/.env for local development (git-ignored).
# In production set these with:  npx supabase secrets set KEY=value

# Fine-grained GitHub token with read-only access to public repositories.
# Optional: without it sync still works, limited to 60 GitHub requests/hour.
GITHUB_TOKEN=

# Shared secret between pg_cron and the github-sync function (any long random string).
CRON_SECRET=

# Salt for hashing contact-form IP addresses before storage (any long random string).
IP_HASH_SALT=

# Comma-separated origins allowed to call the functions from a browser.
# Leave empty locally. Production example:
# ALLOWED_ORIGINS=https://portfolio-c1398.web.app,https://portfolio-c1398.firebaseapp.com
ALLOWED_ORIGINS=

# Email me when someone sends the contact form (optional; https://resend.com, free tier).
# NOTIFY_EMAIL must be the email you signed up to Resend with, unless you verify a domain
# there and set NOTIFY_FROM to an address on it.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=

# Refresh the website right after the sync auto-publishes or updates projects (optional).
# SITE_REVALIDATE_URL: https://<your-site>/api/revalidate
# REVALIDATE_SECRET: any long random string; set the same value as REVALIDATE_SECRET on Vercel.
SITE_REVALIDATE_URL=
REVALIDATE_SECRET=

# Project screenshots (Admin → Projects → "Capture from live demo", Admin → Media).
# Optional. Without these, Microlink's free tier is used (about 50 captures a day).
# SCREENSHOT_API_KEY: a Microlink Pro key for higher limits.
# SCREENSHOT_URL_TEMPLATE: another service's URL with {url} where the page goes;
#   it must answer with the image, e.g. https://image.thum.io/get/width/1440/crop/900/noanimate/{url}
SCREENSHOT_API_KEY=
SCREENSHOT_URL_TEMPLATE=
